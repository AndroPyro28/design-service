generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum category {
  LOGO
  PHOTO
  YOUTUBE_THUMBNAIL
}

model Design {
  id String @id @default(cuid())
  userId String 
  name String
  canvasData String
  width Int
  height Int
  category category @default(YOUTUBE_THUMBNAIL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}